# Copie este arquivo para ".env" e preencha. O .env nunca deve ir para o Git nem ser enviado a ninguém.

# ---------- Servidor ----------
HOST=127.0.0.1
PORT=6050
# Enquanto o n8n estiver ligado, use uma porta diferente da 5678.
# Na virada, aponte o zrok para esta porta.
TZ_LOCAL=America/Sao_Paulo

# true = não envia nada para fora (DigiSac, e-mail, intranet, planilha); só registra no log o que faria
MODO_TESTE=true
# true = liga os agendamentos (vigilância, 13h, 13:20, 08:05, encerramento, chamados ocupados)
AGENDADOR_ATIVO=false

# ---------- Banco ----------
SQLITE_PATH=dados/central_lider.db

# ---------- Intranet Líder ----------
INTRANET_URL=http://192.168.0.6
# Mesmo login que hoje está fixo nos nós "Login Intranet" do n8n
INTRANET_USUARIO=
INTRANET_SENHA=

# ---------- DigiSac ----------
DIGISAC_URL=https://liderinteriores.digisac.co
DIGISAC_TOKEN=
DIGISAC_SERVICE_ID_1=
DIGISAC_SERVICE_ID_2=
DIGISAC_USUARIO_TRANSFERENCIA=12359209-2415-44d7-8407-0fb520a3a476

# ---------- Google Sheets ----------
# Caminho do JSON da conta de serviço (compartilhe a planilha com o e-mail dessa conta)
GOOGLE_CREDENCIAIS_JSON=credenciais/google_service_account.json
PLANILHA_ID=
# Nome da aba (vazio = gid=0, a 'Página1' usada no n8n)
PLANILHA_ABA=Página3

# ---------- E-mail (SMTP) ----------
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_TLS=true
EMAIL_ALERTA_ERRO=

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash-lite

# ---------- Rotas ----------
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
